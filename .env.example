# Copy to .env and fill in. `npm run deploy` pushes the non-empty values into the Modal secret
# `my-voice-env` and writes app/.env (the app's public env) with the server URL and APP_TOKEN.

# Shared bearer token between the app and the server: any long random string.
APP_TOKEN=
# Token the trainer uses to call the server's /internal/reload route: any long random string.
INTERNAL_TOKEN=

# Anthropic: claude-haiku-5-5 repairs the recogniser's guesses, maps "Tell the app" requests, writes Teach sentences.
ANTHROPIC_API_KEY=

# OpenAI Decisions API (gpt-6-luna), the second decision-gate option. EU endpoint for EU processing.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://eu.api.openai.com/v1
PARSE_MODEL=gpt-6-luna

# TypeSafe AI: Jev, the default decision gate, called directly (not through OpenRouter).
TYPESAFE_API_KEY=
DECIDE_MODEL=jev-latest

# ElevenLabs: the clear voice. ELEVENLABS_VOICE_ID is the default until he picks one.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Twilio Programmable Voice with Media Streams: phone calls.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# AI for Accessibility toolkit: his preferences profile. Leave empty to hide toolkit features.
TOOLKIT_URL=
TOOLKIT_TOKEN=
# The app reads the same two in app/.env (the app syncs text size, contrast, motion and voice speed with the profile).
EXPO_PUBLIC_TOOLKIT_URL=
EXPO_PUBLIC_TOOLKIT_TOKEN=

# Optional: Hugging Face token for model downloads.
HF_TOKEN=

# 1 keeps one serving container always on (demo day). Read at deploy time.
KEEP_WARM=0

# The public web app's address (npm run deploy:web), used for his shareable call link. Set it in app/.env too
# so the phone app shares full links.
EXPO_PUBLIC_WEB_URL=https://trymyvoice.vercel.app

# Experiments (EXP-SPEC). 1 makes each one available on the app's Experiments screen, where it stays off until he
# switches it on. Unset or 0 keeps the core product exactly as it is. Read at deploy time; the shell wins over .env.
REALTIME_VOICE=0
LIPS=0
